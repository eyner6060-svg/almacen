# ===========================================
# CONFIGURACION DEL SISTEMA DE ALMACEN
# ===========================================
# Copie este archivo como .env y configure los valores

# -------------------------------------------
# BASE DE DATOS (PostgreSQL)
# -------------------------------------------
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/almacen_db?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres123"
POSTGRES_DB="almacen_db"
POSTGRES_PORT="5432"

# -------------------------------------------
# SEGURIDAD - CRITICO
# -------------------------------------------
# Clave secreta para sesiones (generar con: openssl rand -base64 32)
SESSION_SECRET="cambiar-esta-clave-secreta-en-produccion"

# Clave de cifrado para datos sensibles (generar con: openssl rand -hex 32)
# REQUERIDA en produccion. Minimo 32 caracteres.
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# NOTA: HASH_PEPPER ya no se usa. bcrypt con salt de 12 rondas es suficiente.

# -------------------------------------------
# ENTORNO
# -------------------------------------------
NODE_ENV="development"

# En desarrollo, permitir clave de cifrado derivada (solo si no tienes ENCRYPTION_KEY)
# En produccion esto debe ser false o no estar definido
ALLOW_DEV_ENCRYPTION="true"

# -------------------------------------------
# REDIS (requerido en produccion - para cache, rate limiting y sesiones)
# -------------------------------------------
# En produccion, el rate limiting y bloqueo IP usan Redis en lugar de memoria local.
# Sin Redis, los limites se reinician al reiniciar el servidor y no funcionan con multiples instancias.
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD="redis123"
REDIS_PORT="6379"

# -------------------------------------------
# APLICACION
# -------------------------------------------
PORT=3000
APP_PORT="3000"

# URL publica de la aplicacion (para enlaces de recovery, etc)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Desactivar telemetria de Next.js
NEXT_TELEMETRY_DISABLED=1

# -------------------------------------------
# PGADMIN (Opcional - Administracion de base de datos)
# Activar con: docker compose --profile admin up
# -------------------------------------------
PGADMIN_EMAIL="admin@almacen.local"
PGADMIN_PASSWORD="admin123"
PGADMIN_PORT="5050"

# -------------------------------------------
# REDIS COMMANDER (Opcional - Administracion de Redis)
# Activar con: docker compose --profile admin up
# -------------------------------------------
REDIS_COMMANDER_PORT="8081"
