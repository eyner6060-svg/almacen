[Unit]
Description=Sistema de Gestión de Almacén
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/almacen
ExecStartPre=/usr/bin/docker compose -f /opt/almacen/docker-compose.yml pull
ExecStart=/usr/bin/docker compose -f /opt/almacen/docker-compose.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f /opt/almacen/docker-compose.yml down
ExecReload=/usr/bin/docker compose -f /opt/almacen/docker-compose.yml restart
ExecStartPost=/usr/bin/docker compose -f /opt/almacen/docker-compose.yml exec -T almacen-app wget --no-verbose --tries=1 --spider http://localhost:3000/api/config

StandardOutput=journal
StandardError=journal

User=root
Group=root

[Install]
WantedBy=multi-user.target
